[node name="Rules" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.74, 0.78, 0.9, 1)
theme_override_font_sizes/font_size = 17
autowrap_mode = 2
text = "LINE · clear lines to recover MP (cap 60).\nCHAIN · swap orthogonal cells; 3+ matches include both diagonals. Each resolving wave grants Combo, then recovers MP. A failed swap restores, or spend 1 MP to keep the setup and reset Combo.\nCOMBO · shared cap 10. A category resolves to your current Combo stage; if MP is short, only the needed surplus Combo converts at 5 MP each and previews the highest feasible lower stage.\nSKILL · ATK / DEF / SUP opens a complete tactical pause. Preview first, then CONFIRM."

[node name="AcknowledgeRules" type="Button" parent="Margin/Panel/Content"]
layout_mode = 2
